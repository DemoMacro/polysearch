{
  "name": "polysearch",
  "version": "0.0.9",
  "description": "Unified search interface supporting multiple search engines with deduplication and weighted ranking",
  "keywords": [
    "api-wrapper",
    "autocomplete",
    "driver",
    "duckduckgo",
    "google-cse",
    "http-client",
    "http-server",
    "npm",
    "npm-registry",
    "package-search",
    "polysearch",
    "search",
    "search-api",
    "search-engine",
    "suggestions",
    "typescript",
    "unified-api"
  ],
  "homepage": "https://github.com/DemoMacro/polysearch#readme",
  "bugs": {
    "url": "https://github.com/DemoMacro/polysearch/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/polysearch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./drivers/*": {
      "import": "./dist/drivers/*.mjs",
      "types": "./dist/drivers/*.d.mts"
    },
    "./servers/*": {
      "import": "./dist/servers/*.mjs",
      "types": "./dist/servers/*.d.mts"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "basis build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "h3": "2.0.1-rc.20",
    "ofetch": "1.5.1",
    "playwright": "1.59.1",
    "unstorage": "1.17.5"
  }
}
